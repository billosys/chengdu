#!/usr/bin/env bash
# Mechanizes PANDA Runbook §5-§6 as executable gates against in-repo
# fixtures. Two modes:
#   (default)   the three-gate positive chain on fixtures/minimal —
#               parse, ground, solve (Status: Solved) — with a per-gate
#               PASS summary.
#   --negative  four distinct negative outcomes: missing file (parser
#               exit 20), broken-syntax fixture (exit 22),
#               broken-reference fixture (exit 22), and the unsolvable
#               fixture (engine exit 2 and "Status: Proven unsolvable",
#               which must be classified as UNSOLVABLE, never as
#               success and never as a generic failure).
#
# Nonzero exit whenever any gate deviates from its expected outcome, in
# either mode. --corpus DIR runs the Transport pfile01 loop when an
# ipc2023-domains checkout is present at DIR; optional, not part of the
# required gate.
#
# Crash-simulation test (CDC-3 regression check): every pandaPI
# invocation runs inside an explicit `set +e` / `set -e` bracket (via
# run_and_capture/require_step or inline), so a binary that crashes
# produces a labeled FAIL + nonzero overall exit rather than a silent
# `set -e` abort with no summary. To reproduce manually, after a normal
# build:
#   real="dist/<platform>/pandapi-engine"
#   cp "$real" "$real.orig"
#   printf '#!/bin/sh\nexit 3\n' > "$real"; chmod +x "$real"
#   make smoke; echo "exit=$?"              # expect a "solve: expected
#     exit 0 ... got exit 3" FAIL line and overall exit 1, not a bare
#     bash abort
#   mv "$real.orig" "$real"                 # restore the real binary
set -euo pipefail

usage() {
  cat <<'EOF'
Use Make targets:
  make smoke
  make smoke-negative
  make test-corpus CORPUS_DIR=...

  (default)   run the positive gate chain against fixtures/minimal.
  --negative  run the four negative-gate fixtures instead.
  --corpus DIR  additionally run the Transport pfile01 loop from an
                ipc2023-domains checkout at DIR (positive mode only).
EOF
}

MODE=positive
CORPUS_DIR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --negative)
      MODE=negative
      shift
      ;;
    --corpus)
      CORPUS_DIR="${2:-}"
      shift 2
      ;;
    --corpus=*)
      CORPUS_DIR="${1#*=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "smoke-run: unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
# shellcheck source=tools/shared/platform
. "$REPO_ROOT/tools/shared/platform"

PLATFORM="$(detect_platform)"
DIST_DIR="$REPO_ROOT/dist/$PLATFORM"
FIXTURES_DIR="$REPO_ROOT/fixtures"

P="$DIST_DIR/pandapi-parser"
G="$DIST_DIR/pandapi-grounder"
E="$DIST_DIR/pandapi-engine"

for bin in "$P" "$G" "$E"; do
  if [ ! -x "$bin" ]; then
    echo "smoke-run: missing binary: $bin - run make build first" >&2
    exit 1
  fi
done

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

PASS_COUNT=0
FAIL_COUNT=0

gate_pass() {
  echo "smoke-run: PASS: $1"
  PASS_COUNT=$((PASS_COUNT + 1))
}

gate_fail() {
  echo "smoke-run: FAIL: $1" >&2
  FAIL_COUNT=$((FAIL_COUNT + 1))
}

# strip_ansi <string> — inherited planner diagnostics can include ANSI SGR
# codes on some paths. Strip unconditionally before matching diagnostics.
strip_ansi() {
  printf '%s' "$1" | sed $'s/\x1b\\[[0-9;]*m//g'
}

# run_and_capture <cmd...> — sets OUT (ANSI-stripped) and RC, without
# tripping set -e on an intentionally-nonzero exit (the negative
# fixtures rely on this).
OUT=""
RC=0
run_and_capture() {
  set +e
  OUT="$("$@" 2>&1)"
  RC=$?
  set -e
  OUT="$(strip_ansi "$OUT")"
}

# require_step <label> <cmd...> — a setup call with no dedicated gate of
# its own (e.g. the parse/ground steps ahead of a solve gate). Routes
# through run_and_capture so an unexpected crash reports as a labeled
# FAIL instead of aborting the script silently under set -e; returns 1
# so the caller can skip whatever depended on it.
require_step() {
  local label="$1"
  shift
  run_and_capture "$@"
  if [ "$RC" -ne 0 ]; then
    gate_fail "$label: expected exit 0, got $RC: $OUT"
    return 1
  fi
  return 0
}

# run_engine <sas-file> <out-file> — invoke the engine with a bounded
# wall-clock timeout, portably (no dependency on GNU coreutils'
# timeout/gtimeout — stock macOS ships neither). Sets RC: the engine's
# own exit code, or 124 (matching GNU timeout's convention) if it had
# to be killed. Found live during a refuse-to-publish rehearsal: a
# deliberately-broken upstream fixture fed the engine a malformed .sas
# file, and it spun indefinitely (12+ GB RSS, climbing) instead of
# failing fast — every prior gate reported a clean labeled FAIL, but
# this one would have hung a CI job for hours with no FAIL at all.
ENGINE_TIMEOUT_SECS=60
run_engine() {
  local sas="$1" out="$2" pid watcher
  "$E" --status=stderr --output "$out" "$sas" > "$out.stdout" 2> "$out.stderr" &
  pid=$!
  ( sleep "$ENGINE_TIMEOUT_SECS"; kill -9 "$pid" 2>/dev/null ) &
  watcher=$!
  set +e
  wait "$pid"
  RC=$?
  kill "$watcher" 2>/dev/null
  wait "$watcher" 2>/dev/null
  set -e
  if [ "$RC" -eq 137 ]; then
    RC=124
    echo "smoke-run: engine killed after ${ENGINE_TIMEOUT_SECS}s timeout" >> "$out.stderr"
  fi
}

run_positive() {
  local fdir="$FIXTURES_DIR/minimal"
  local htn="$WORK/dp.htn" sas="$WORK/dp.sas" raw="$WORK/plan.raw"

  run_and_capture "$P" "$fdir/domain.hddl" "$fdir/problem.hddl" "$htn"
  if [ "$RC" -eq 0 ]; then
    gate_pass "parse (exit 0)"
  else
    gate_fail "parse: expected exit 0, got $RC: $OUT"
  fi

  run_and_capture "$G" "$htn" "$sas"
  if [ "$RC" -eq 0 ]; then
    gate_pass "ground (exit 0)"
  else
    gate_fail "ground: expected exit 0, got $RC: $OUT"
  fi

  run_engine "$sas" "$raw"
  if [ "$RC" -eq 0 ] && grep -q '^- Status: Solved$' "$raw" && grep -q 'PANDAPI_STATUS.*status=ok.*component=engine' "$raw.stderr"; then
    gate_pass "solve (exit 0, Status: Solved, engine status ok)"
  else
    gate_fail "solve: expected exit 0 + 'Status: Solved' + engine status ok, got exit $RC: $(grep 'Status:' "$raw" || echo 'no Status line')"
  fi
}

run_negative() {
  # a. missing file -> parser exit 20, stable managed diagnostic
  run_and_capture "$P" "$WORK/does-not-exist.hddl" "$FIXTURES_DIR/minimal/problem.hddl" "$WORK/missing.htn"
  if [ "$RC" -eq 20 ] && printf '%s' "$OUT" | grep -q "cannot read domain"; then
    gate_pass "negative: missing file -> exit 20, input_unavailable"
  else
    gate_fail "negative: missing file: expected exit 20 + input_unavailable diagnostic, got exit $RC"
  fi

  # b. broken-syntax -> parser exit 22, stable managed diagnostic
  run_and_capture "$P" "$FIXTURES_DIR/broken-syntax/domain.hddl" "$FIXTURES_DIR/broken-syntax/problem.hddl" "$WORK/broken-syntax.htn"
  if [ "$RC" -eq 22 ] && printf '%s' "$OUT" | grep -q "parser input invalid"; then
    gate_pass "negative: broken-syntax -> exit 22, input_invalid"
  else
    gate_fail "negative: broken-syntax: expected exit 22 + input_invalid diagnostic, got exit $RC"
  fi

  # c. broken-reference -> parser exit 22, stable managed diagnostic
  run_and_capture "$P" "$FIXTURES_DIR/broken-reference/domain.hddl" "$FIXTURES_DIR/broken-reference/problem.hddl" "$WORK/broken-reference.htn"
  if [ "$RC" -eq 22 ] && printf '%s' "$OUT" | grep -q "parser input invalid"; then
    gate_pass "negative: broken-reference -> exit 22, input_invalid"
  else
    gate_fail "negative: broken-reference: expected exit 22 + input_invalid diagnostic, got exit $RC"
  fi

  # d. unsolvable -> engine exit 2 and Status: Proven unsolvable —
  # classified UNSOLVABLE, never success, never a generic failure.
  local htn="$WORK/uns.htn" sas="$WORK/uns.sas" raw="$WORK/uns.raw"
  if require_step "negative: unsolvable setup (parse)" "$P" "$FIXTURES_DIR/unsolvable/domain.hddl" "$FIXTURES_DIR/unsolvable/problem.hddl" "$htn" \
    && require_step "negative: unsolvable setup (ground)" "$G" "$htn" "$sas"; then
    run_engine "$sas" "$raw"
    if [ "$RC" -eq 2 ] && [ ! -e "$raw" ] && grep -q 'PANDAPI_STATUS.*status=domain_no_plan.*component=engine' "$raw.stderr"; then
      gate_pass "negative: unsolvable -> engine exit 2, domain_no_plan (UNSOLVABLE, not success, not failure)"
    else
      gate_fail "negative: unsolvable: expected exit 2 + domain_no_plan status and no plan artifact, got exit $RC"
    fi
  fi
}

run_corpus() {
  local dir="$1"
  local dom="$dir/total-order/Transport/domain.hddl"
  local prob="$dir/total-order/Transport/pfile01.hddl"

  if [ ! -f "$dom" ] || [ ! -f "$prob" ]; then
    echo "smoke-run: --corpus $dir missing total-order/Transport/{domain,pfile01}.hddl — skipping" >&2
    return 0
  fi

  local t="$WORK/t.htn" tsas="$WORK/t.sas" tout="$WORK/t.out"
  if ! require_step "corpus: Transport pfile01 setup (parse)" "$P" "$dom" "$prob" "$t"; then
    return 0
  fi
  if ! require_step "corpus: Transport pfile01 setup (ground)" "$G" "$t" "$tsas"; then
    return 0
  fi

  run_engine "$tsas" "$tout"

  if grep -q '^- Status: Solved$' "$tout" && grep -q 'PANDAPI_STATUS.*status=ok.*component=engine' "$tout.stderr"; then
    gate_pass "corpus: Transport pfile01 solved with engine status ok"
  else
    gate_fail "corpus: Transport pfile01 did not solve with engine status ok"
  fi

}

echo "smoke-run: platform=$PLATFORM mode=$MODE"

case "$MODE" in
  positive)
    run_positive
    if [ -n "$CORPUS_DIR" ]; then
      run_corpus "$CORPUS_DIR"
    fi
    ;;
  negative)
    run_negative
    ;;
esac

echo "smoke-run: SUMMARY: $PASS_COUNT passed, $FAIL_COUNT failed ($MODE mode, $PLATFORM)"

if [ "$FAIL_COUNT" -gt 0 ]; then
  exit 1
fi
exit 0
