# chengdu - vendored source identities
#
# Active provenance source for the in-tree pandaPI fork. Each entry records:
#   PREFIX: current source path in this repository
#   URL: original upstream repository
#   UPSTREAM_SHA: upstream commit imported into chengdu history
#   IMPORT_COMMIT: chengdu subtree/import commit that introduced that source
#
# The current build source is chengdu's own Git commit. These upstream SHAs
# are import identities, not the build-source identity for release binaries.

PARSER_PREFIX=pandaPI/parser
PARSER_IMPORT_PREFIX=pandaPI/pandaPIparser
PARSER_URL=https://github.com/panda-planner-dev/pandaPIparser.git
PARSER_UPSTREAM_SHA=88c0995c72c5ce2685e9546ec153a3545977ed81
PARSER_IMPORT_COMMIT=ac8e385d

