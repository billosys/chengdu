write_compile_entry() {
  local file="$1" command="$2" directory="$3" comma="$4"
  printf '%s\n' "  {"
  printf '    "directory": "%s",\n' "$(json_string "$directory")"
  printf '    "command": "%s",\n' "$(json_string "$command")"
  printf '    "file": "%s"\n' "$(json_string "$file")"
  if [ "$comma" = "yes" ]; then
    printf '%s\n' "  },"
  else
    printf '%s\n' "  }"
  fi
}

write_compile_db_from_list() {
  local component="$1" db_dir="$2" list="$3" compile_flags="$4" c_compile_flags="$5"
  local json="$db_dir/compile_commands.json"
  local first="$db_dir/first-party-selected.txt"
  local filter="$db_dir/filter-report.md"
  local tmp total index rel abs ext cmd

  tmp="$db_dir/entries.tmp"
  mkdir -p "$db_dir"
  : > "$tmp"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    abs="$REPO_ROOT/$rel"
    ext="${rel##*.}"
    if [ "$ext" = "c" ]; then
      cmd="cc $c_compile_flags -c $abs -o $db_dir/objects/${rel##*/}.o"
    else
      cmd="c++ $compile_flags -c $abs -o $db_dir/objects/${rel##*/}.o"
    fi
    printf '%s\t%s\n' "$abs" "$cmd" >> "$tmp"
  done < "$list"

  total="$(wc -l < "$tmp" | tr -d ' ')"
  index=0
  {
    printf '%s\n' "["
    while IFS="$(printf '\t')" read -r abs cmd; do
      index=$((index + 1))
      if [ "$index" -lt "$total" ]; then
        write_compile_entry "$abs" "$cmd" "$REPO_ROOT" "yes"
      else
        write_compile_entry "$abs" "$cmd" "$REPO_ROOT" "no"
      fi
    done < "$tmp"
    printf '%s\n' "]"
  } > "$json"
  rm -f "$tmp"

  {
    while IFS= read -r rel; do
      if is_first_party_translation_unit "$component" "$rel"; then
        printf '%s\n' "$rel"
      fi
    done < "$list"
  } > "$first"

  {
    printf '%s\n' "# $component compile database filter evidence"
    printf '\n'
    printf '%s\n' "compile_commands: compile_commands.json"
    printf '%s\n' "first-party selected translation units: first-party-selected.txt"
    printf '%s\n' "selected count: $(wc -l < "$first" | tr -d ' ')"
    printf '\n'
    printf '%s\n' "Exclusions encoded for this component:"
    printf '%s\n' "- GENERATED generated build output: cmdline.(c|h), hddl.(cpp|hpp), hddl-token.cpp"
    printf '%s\n' "- GENERATOR first-party generator/template: hddl.y, hddl-token.l, options.ggo"
    printf '%s\n' "- THIRD_PARTY vendored third-party: cpddl/third-party and cudd-3.0.0"
    printf '%s\n' "- DEPENDENCY dependency-internal: cpddl and h2-fd-preprocessor"
    printf '%s\n' "- COPIED_BUILD source map: build/$PLATFORM/source and build/\$(PLATFORM)/source"
    printf '%s\n' "- BUILD_OUTPUT generated build output: build, dist, release"
  } > "$filter"
}

parser_compile_db() {
  local db_dir list
  db_dir="$(component_compile_dir parser)"
  list="$db_dir/raw-translation-units.txt"
  mkdir -p "$db_dir/objects"
  {
    find "$REPO_ROOT/pandaPI/parser/src" -maxdepth 1 -type f -name '*.cpp' | sed "s#^$REPO_ROOT/##"
    printf '%s\n' "pandaPI/parser/src/hddl.cpp"
    printf '%s\n' "pandaPI/parser/src/hddl-token.cpp"
    printf '%s\n' "pandaPI/parser/src/cmdline.c"
  } | sort > "$list"
  write_compile_db_from_list parser "$db_dir" "$list" "-O3 -pipe -Wall -Wextra -pedantic -std=c++17 -DNDEBUG -IpandaPI/runtime/include -Wno-unused-parameter" "-O3 -pipe -Wall -Wextra -pedantic -DNDEBUG -Wno-unused-parameter"
}

grounder_compile_db() {
  local db_dir list
  db_dir="$(component_compile_dir grounder)"
  list="$db_dir/raw-translation-units.txt"
  mkdir -p "$db_dir/objects"
  {
    find "$REPO_ROOT/pandaPI/grounder/src" -maxdepth 1 -type f \( -name '*.cpp' -o -name '*.c' \) | sed "s#^$REPO_ROOT/##"
    printf '%s\n' "pandaPI/grounder/src/cmdline.c"
    find "$REPO_ROOT/pandaPI/grounder/h2-fd-preprocessor/src" -maxdepth 1 -type f -name '*.cc' | sed "s#^$REPO_ROOT/##"
  } | sort -u > "$list"
  write_compile_db_from_list grounder "$db_dir" "$list" "-O3 -pipe -Wall -Wextra -pedantic -std=gnu++20 -DNDEBUG -IpandaPI/runtime/include -IpandaPI/grounder/cpddl -IpandaPI/grounder/cpddl/third-party/boruvka -Wno-unused-parameter -Wno-sign-compare" "-O3 -pipe -Wall -Wextra -pedantic -DNDEBUG -Wno-unused-parameter -Wno-sign-compare"
}

engine_compile_db() {
  local db_dir build_dir raw selected filter
  db_dir="$(component_compile_dir engine)"
  build_dir="$db_dir/build"
  raw="$db_dir/compile_commands.json"
  selected="$db_dir/first-party-selected.txt"
  filter="$db_dir/filter-report.md"
  mkdir -p "$build_dir"
  cmake -S "$REPO_ROOT/pandaPI/engine/src" -B "$build_dir" \
    -DCMAKE_BUILD_TYPE=Debug \
    -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
    -DPANDAPI_RUNTIME_INCLUDE="$REPO_ROOT/pandaPI/runtime/include" >/dev/null
  cp "$build_dir/compile_commands.json" "$raw"
  sed -nE 's#^[[:space:]]*"file": "([^"]*pandaPI/engine/src/[^"]*[.](cpp|cc|cxx))",?#\1#p' "$raw" \
    | sed "s#^$REPO_ROOT/##" \
    | rg -v 'cudd-3.0.0|cmdline\.c' \
    | sort -u > "$selected"
  {
    printf '%s\n' "# engine compile database filter evidence"
    printf '\n'
    printf '%s\n' "compile_commands: compile_commands.json"
    printf '%s\n' "first-party selected translation units: first-party-selected.txt"
    printf '%s\n' "selected count: $(wc -l < "$selected" | tr -d ' ')"
    printf '\n'
    printf '%s\n' "Exclusions encoded for this component:"
    printf '%s\n' "- GENERATED generated build output: cmdline.(c|h)"
    printf '%s\n' "- GENERATOR first-party generator/template: options.ggo"
    printf '%s\n' "- THIRD_PARTY vendored third-party: pandaPI/engine/src/symbolic_search/cudd-3.0.0"
    printf '%s\n' "- COPIED_BUILD source map: build/$PLATFORM/source and build/\$(PLATFORM)/source"
    printf '%s\n' "- BUILD_OUTPUT generated build output: build, dist, release"
  } > "$filter"
}

compile_db() {
  local component="$1"
  case "$component" in
    parser)
      parser_compile_db
      ;;
    grounder)
      grounder_compile_db
      ;;
    engine)
      engine_compile_db
      ;;
    *)
      die "unknown component '$component'"
      ;;
  esac
}

compile_db_summary() {
  local root component first out
  root="$OUT_DIR/compile-db"
  out="$root/first-party-selected.txt"
  mkdir -p "$root"
  : > "$out"
  for component in parser grounder engine; do
    first="$root/$component/first-party-selected.txt"
    if [ ! -s "$first" ]; then
      die "$first missing; run make compile-db-$component"
    fi
    sed "s#^#$component	#" "$first" >> "$out"
  done
  {
    printf '%s\n' "# First-party compile database summary"
    printf '\n'
    for component in parser grounder engine; do
      first="$root/$component/first-party-selected.txt"
      printf '%s\n' "- $component: $(wc -l < "$first" | tr -d ' ') first-party selected translation units"
    done
  } > "$root/first-party-filter-report.md"
}

if [ "$#" -lt 3 ]; then
  usage
  exit 2
fi

COMMAND="$1"
case "$COMMAND" in
  surface|profile-map|naming-report|naming-check|compile-db-summary|gate-report|generated-warning-triage)
    REPO_ROOT="${2%/}"
    PLATFORM="$3"
    shift 3
    ;;
  compile-db)
    if [ "$#" -ne 4 ]; then
      usage
      exit 2
    fi
    COMPONENT="$2"
    REPO_ROOT="${3%/}"
    PLATFORM="$4"
    shift 4
    ;;
  *)
    usage
    exit 2
    ;;
esac

OUT_DIR="$REPO_ROOT/build/source-quality/$PLATFORM"
require_repo

case "$COMMAND" in
  surface)
    write_surface
    ;;
  profile-map)
    write_profile_map
    ;;
  naming-report)
    write_naming_report
    ;;
  naming-check)
    naming_check
    ;;
  compile-db)
    compile_db "$COMPONENT"
    ;;
  compile-db-summary)
    compile_db_summary
    ;;
  gate-report|generated-warning-triage)
    write_gate_scaffold_report
    ;;
esac
