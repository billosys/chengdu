#!/usr/bin/env bash
# Make-invoked source-quality selector and compile database helper.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage:
  tools/source-quality/surface surface <repo-root> <platform>
  tools/source-quality/surface profile-map <repo-root> <platform>
  tools/source-quality/surface naming-report <repo-root> <platform>
  tools/source-quality/surface naming-check <repo-root> <platform>
  tools/source-quality/surface compile-db <parser|grounder|engine> <repo-root> <platform>
  tools/source-quality/surface compile-db-summary <repo-root> <platform>
USAGE
}

die() {
  printf '%s\n' "source-quality: $*" >&2
  exit 1
}

require_repo() {
  if [ ! -d "$REPO_ROOT/pandaPI" ]; then
    die "missing pandaPI source root under $REPO_ROOT"
  fi
}

json_escape() {
  sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_string() {
  printf '%s' "$1" | json_escape
}

make_out_dir() {
  mkdir -p "$OUT_DIR"
}

component_compile_dir() {
  printf '%s/compile-db/%s' "$OUT_DIR" "$1"
}

is_first_party_translation_unit() {
  local component="$1" path="$2"
  if [ "$component" = "engine" ]; then
    case "$path" in
      pandaPI/engine/src/symbolic_search/cudd-3.0.0/*|pandaPI/engine/src/cmdline.c)
        return 1
        ;;
      pandaPI/engine/src/*.cpp)
        return 0
        ;;
    esac
  fi
  case "$component:$path" in
    parser:pandaPI/parser/src/hddl.cpp|\
    parser:pandaPI/parser/src/hddl-token.cpp|\
    parser:pandaPI/parser/src/cmdline.c|\
    grounder:pandaPI/grounder/src/cmdline.c|\
    grounder:pandaPI/grounder/h2-fd-preprocessor/*|\
    grounder:pandaPI/grounder/cpddl/*|\
    engine:pandaPI/engine/src/cmdline.c|\
    engine:pandaPI/engine/src/symbolic_search/cudd-3.0.0/*)
      return 1
      ;;
    parser:pandaPI/parser/src/*.cpp|\
    grounder:pandaPI/grounder/src/*.cpp|\
    grounder:pandaPI/grounder/src/rss.c)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

classify_path() {
  local path="$1"
  case "$path" in
    build/*/source/*)
      printf '%s' "COPIED_BUILD source map"
      ;;
    build/*|dist/*|release/*)
      printf '%s' "BUILD_OUTPUT generated build output"
      ;;
    pandaPI/grounder/cpddl/third-party/*|pandaPI/engine/src/symbolic_search/cudd-3.0.0/*)
      printf '%s' "THIRD_PARTY vendored third-party"
      ;;
    pandaPI/grounder/cpddl/*|pandaPI/grounder/h2-fd-preprocessor/*)
      printf '%s' "DEPENDENCY dependency-internal"
      ;;
    */hddl.y|*/hddl-token.l|*/options.ggo)
      printf '%s' "GENERATOR first-party generator/template"
      ;;
    */cmdline.c|*/cmdline.h|*/hddl.cpp|*/hddl.hpp|*/hddl-token.cpp)
      printf '%s' "GENERATED generated build output"
      ;;
    pandaPI/parser/src/*|pandaPI/grounder/src/*|pandaPI/engine/src/*|pandaPI/runtime/include/*|pandaPI/runtime/src/*|pandaPI/runtime/tests/*)
      printf '%s' "FIRST_PARTY first-party maintained"
      ;;
    *)
      printf '%s' "OTHER component documentation/data"
      ;;
  esac
}

list_first_party_files() {
  find "$REPO_ROOT/pandaPI/parser/src" "$REPO_ROOT/pandaPI/grounder/src" \
    "$REPO_ROOT/pandaPI/engine/src" "$REPO_ROOT/pandaPI/runtime/include" \
    "$REPO_ROOT/pandaPI/runtime/src" "$REPO_ROOT/pandaPI/runtime/tests" \
    -type f \( -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hh' -o -name '*.hpp' \) \
    ! -path '*/cudd-3.0.0/*' \
    | sed "s#^$REPO_ROOT/##" \
    | sort
}

list_first_party_dirs() {
  find "$REPO_ROOT/pandaPI/parser/src" "$REPO_ROOT/pandaPI/grounder/src" \
    "$REPO_ROOT/pandaPI/engine/src" "$REPO_ROOT/pandaPI/runtime/include" \
    "$REPO_ROOT/pandaPI/runtime/src" "$REPO_ROOT/pandaPI/runtime/tests" \
    -type d \
    ! -path '*/cudd-3.0.0' \
    ! -path '*/cudd-3.0.0/*' \
    | sed "s#^$REPO_ROOT/##" \
    | sort
}

is_lower_snake_name() {
  local name="$1" stem="$1"
  case "$name" in
    CMakeLists.txt|Makefile|makefile)
      return 0
      ;;
    *.*)
      stem="${name%.*}"
      ;;
  esac
  case "$stem" in
    ''|_*|*_|*__*|*[!a-z0-9_]*)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

naming_violations() {
  local path base class
  list_first_party_files | while IFS= read -r path; do
    class="$(classify_path "$path")"
    case "$class" in
      FIRST_PARTY*)
        base="${path##*/}"
        if ! is_lower_snake_name "$base"; then
          printf '%s\t%s\n' "file" "$path"
        fi
        ;;
    esac
  done
  list_first_party_dirs | while IFS= read -r path; do
    base="${path##*/}"
    if ! is_lower_snake_name "$base"; then
      printf '%s\t%s\n' "dir" "$path"
    fi
  done
}

