write_naming_report() {
  make_out_dir
  local report="$REPO_ROOT/docs/design-v0.3.0/arc07-source-quality-expansion/source-naming-normalization.md"
  local evidence="$OUT_DIR/source-quality-naming-violations.tsv"
  local file_count dir_count violation_count rename_count

  list_first_party_files | while IFS= read -r path; do
    case "$(classify_path "$path")" in
      FIRST_PARTY*) printf '%s\n' "$path" ;;
    esac
  done > "$OUT_DIR/source-quality-naming-files.txt"
  list_first_party_dirs > "$OUT_DIR/source-quality-naming-dirs.txt"
  naming_violations > "$evidence"

  file_count="$(wc -l < "$OUT_DIR/source-quality-naming-files.txt" | tr -d ' ')"
  dir_count="$(wc -l < "$OUT_DIR/source-quality-naming-dirs.txt" | tr -d ' ')"
  violation_count="$(wc -l < "$evidence" | tr -d ' ')"
  rename_count="$(rename_map | tail -n +2 | wc -l | tr -d ' ')"

  {
    printf '%s\n' "# Arc07 Source Naming Normalization"
    printf '\n'
    printf '%s\n' "Status: Slice03 implementation report"
    printf '%s\n' "Platform evidence: $PLATFORM"
    printf '\n'
    printf '%s\n' "## Accepted naming policy"
    printf '\n'
    printf '%s\n' "First-party maintained C/C++ source files and first-party source directories use lower snake case basenames. The check accepts lowercase ASCII letters, digits, and single underscores in the stem. Acronym clusters are normalized as words when the mapping is clear, for example \`hddl_writer\`, \`h2_mutexes\`, \`int_data_structures\`, and \`progression_network\`."
    printf '\n'
    printf '%s\n' "Conventional build filenames such as \`CMakeLists.txt\`, \`Makefile\`, and \`makefile\` are exempt. C++ identifiers, class names, CMake target names, public binary names, and managed-process behavior are not renamed by this policy."
    printf '\n'
    printf '%s\n' "## Source-class exclusions"
    printf '\n'
    printf '%s\n' "The excluded paths are not silently promoted into first-party maintained naming scope:"
    printf '\n'
    printf '%s\n' "- \`GENERATED\` generated output such as Flex/Bison/gengetopt \`cmdline.c\`, \`cmdline.h\`, \`hddl.cpp\`, \`hddl.hpp\`, and \`hddl-token.cpp\`."
    printf '%s\n' "- \`GENERATOR\` inputs such as \`hddl.y\`, \`hddl-token.l\`, and \`options.ggo\`; they are source-classed separately from maintained C/C++ files."
    printf '%s\n' "- \`THIRD_PARTY\` and \`DEPENDENCY\` roots, including \`pandaPI/grounder/cpddl\`, \`pandaPI/grounder/h2-fd-preprocessor\`, nested cpddl third-party source, and \`pandaPI/engine/src/symbolic_search/cudd-3.0.0\`."
    printf '%s\n' "- \`COPIED_BUILD\` and \`BUILD_OUTPUT\` roots under \`build/\`, \`dist/\`, and \`release/\`."
    printf '\n'
    printf '%s\n' "## Initial inventory summary"
    printf '\n'
    printf '%s\n' "Slice03 normalized the non-conforming first-party maintained C/C++ path surface identified after Slice02. Initial violations were concentrated in parser writer files, grounder helper/model files, and engine root, heuristic, landmark, data-structure, search, and translation files/directories."
    printf '\n'
    printf '%s\n' "| Current checked surface | Count |"
    printf '%s\n' "|-------------------------|-------|"
    printf '%s\n' "| first-party maintained C/C++ files | $file_count |"
    printf '%s\n' "| first-party source directories | $dir_count |"
    printf '%s\n' "| current naming violations | $violation_count |"
    printf '%s\n' "| final rename map entries | $rename_count |"
    printf '\n'
    printf '%s\n' "Generated evidence is written to \`build/source-quality/$PLATFORM/source-quality-naming-violations.tsv\`."
    printf '\n'
    printf '%s\n' "## Final rename map"
    printf '\n'
    printf '%s\n' "| Old path | New path |"
    printf '%s\n' "|----------|----------|"
    rename_map | tail -n +2 | while IFS="$(printf '\t')" read -r old new; do
      printf "| \`%s\` | \`%s\` |\n" "$old" "$new"
    done
  } > "$report"

  printf '%s\n' "$report"
}

naming_check() {
  make_out_dir
  local evidence="$OUT_DIR/source-quality-naming-violations.tsv"
  naming_violations > "$evidence"
  if [ -s "$evidence" ]; then
    printf '%s\n' "source-quality: first-party source naming violations:" >&2
    cat "$evidence" >&2
    return 1
  fi
}

