;; domain.hddl — variant of fixtures/minimal where the method skips
;; `draft`, so `review`'s precondition (drafted ?a) can never be
;; established. Parses and grounds cleanly; provably unsolvable at
;; search time — the engine's `Status: Proven unsolvable` trap (exit 0).
(define (domain project-work)
  (:types slice artifact)
  (:predicates (drafted ?a - artifact) (reviewed ?a - artifact))

  (:task produce :parameters (?a - artifact))

  (:method m-produce
    :parameters (?a - artifact)
    :task (produce ?a)
    :ordered-subtasks (review ?a))

  (:action draft
    :parameters (?a - artifact)
    :effect (drafted ?a))

  (:action review
    :parameters (?a - artifact)
    :precondition (drafted ?a)
    :effect (reviewed ?a)))
