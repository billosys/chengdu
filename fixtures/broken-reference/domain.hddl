;; domain.hddl — variant of fixtures/minimal with an undeclared-predicate
;; reference ("draffted" for "drafted") in draft's effect, for the smoke
;; test's semantic-error 255 path — distinct from the broken-syntax path.
(define (domain project-work)
  (:types slice artifact)
  (:predicates (drafted ?a - artifact) (reviewed ?a - artifact))

  (:task produce :parameters (?a - artifact))

  (:method m-produce
    :parameters (?a - artifact)
    :task (produce ?a)
    :ordered-subtasks (and (draft ?a) (review ?a)))

  (:action draft
    :parameters (?a - artifact)
    :effect (draffted ?a))

  (:action review
    :parameters (?a - artifact)
    :precondition (drafted ?a)
    :effect (reviewed ?a)))
