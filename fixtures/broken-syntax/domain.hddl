;; domain.hddl — variant of fixtures/minimal with an unbalanced-paren
;; syntax error in the :effect clause, for the smoke test's 255 path.
(define (domain project-work)
  (:types slice artifact)
  (:predicates (drafted ?a - artifact) (reviewed ?a - artifact))

  (:task produce :parameters (?a - artifact))

  (:method m-produce
    :parameters (?a - artifact)
    :task (produce ?a)
    :ordered-subtasks (and (draft ?a) (review ?a)))

  (:action draft
    :parameters (?a - artifact)
    :effect (drafted ?a)

  (:action review
    :parameters (?a - artifact)
    :precondition (drafted ?a)
    :effect (reviewed ?a)))
